APP_NAME="Financial Data PII Scrubber"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api"

# Set DATABASE_URL in a local .env file before enabling database persistence.
# Example: postgresql+psycopg://<db_user>:<db_password>@<db_host>:5432/<db_name>
DATABASE_URL="postgresql+psycopg://<db_user>:<db_password>@localhost:5432/financial_pii_scrubber"
DB_ECHO=false

LOG_LEVEL="INFO"

ALLOWED_FILE_TYPES=".pdf,.docx,.csv,.txt"
MAX_UPLOAD_SIZE_MB=10
LOCAL_PROCESSING_DIRECTORY="./data"

GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="your_llama_model_name_here"
